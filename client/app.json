{
  "expo": {
    "name": "VideoCall",
    "slug": "videocall-app",
    "version": "1.0.0",
    "scheme": "videocall",
    "orientation": "portrait",

    "icon": "./assets/icon.png",

    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },

    "userInterfaceStyle": "dark",

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.videocall.app"
    },

    "android": {
      "package": "com.videocall.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0f172a"
      },
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép VideoCallApp truy cập ảnh của bạn",
          "cameraPermission": "Cho phép VideoCallApp dùng camera"
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true
    }
  }
}
{
  "expo": {
    "name": "VideoCall",
    "slug": "videocall-app",
    "version": "1.0.0",
    "scheme": "videocall",
    "orientation": "portrait",

    "icon": "./assets/adaptive-icon.png",

    "userInterfaceStyle": "dark",

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.videocall.app"
    },

    "android": {
      "package": "com.videocall.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050110"
      },
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "bundler": "metro",
      "favicon": "./assets/adaptive-icon.png"
    },

    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#050110",
          "dark": {
            "image": "./assets/adaptive-icon.png",
            "backgroundColor": "#050110"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép VideoCallApp truy cập ảnh của bạn",
          "cameraPermission": "Cho phép VideoCallApp dùng camera"
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true
    }
  }
}